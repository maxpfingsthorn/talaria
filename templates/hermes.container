# Managed by Talaria. Re-run `talaria setup` after changing talaria.conf.
[Unit]
Description=Hermes Agent (managed by Talaria)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=hermes
Image=localhost/hermes-agent:current
Pull=never
UserNS=keep-id:uid=10000,gid=10000
Volume=${data_dir}:/opt/data
Environment=HERMES_UID=10000 HERMES_GID=10000 HERMES_SKIP_CONFIG_MIGRATION=1
Environment=HERMES_DASHBOARD=1 HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
EnvironmentFile=${app_env}
${host_net}PublishPort=${bind_ip}:${port}:9119
${add_hosts}Exec=gateway run

[Service]
ExecCondition=/bin/sh -c 'test ! -e "${marker}"'
${wait_addr}
Restart=on-failure
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=default.target
