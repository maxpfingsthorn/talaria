#!/usr/bin/env bash
# Thin wrapper: resolve the checkout (this file may be reached via a symlink).
# Not `python3 -m talaria`: -m puts the caller's cwd first on sys.path, so another
# checkout in the cwd would shadow this one.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
TALARIA_ROOT="$here" exec python3 -I -c '
import os, sys
sys.path.insert(0, os.environ["TALARIA_ROOT"])
from talaria.cli import main
sys.exit(main())' "$@"
